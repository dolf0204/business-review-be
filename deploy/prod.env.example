# Settings for the server. Copy to prod.env on the server and fill in every value. prod.env is ignored by git.
# Never paste these values into chat or commit them.

DOMAIN=businessask.eu
# Public addresses. DNS A records for the bare domain, www. and api. must point at the server before the first start.
PUBLIC_API_URL=https://api.businessask.eu
APP_URL=https://businessask.eu
API_SITE=api.businessask.eu
APP_SITE=businessask.eu
COOKIE_SECURE=true

POSTGRES_PASSWORD=
JWT_SECRET=

# Cloudflare Turnstile (real keys; the site key is public, the secret is not). Allow businessask.eu in the widget's hostnames.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@businessask.eu
# Server key for the Places API (New). Restrict it to that API and to this server's address.
GOOGLE_PLACES_API_KEY=
# Browser key for Maps JavaScript API, restricted to https://businessask.eu/*. Empty uses OpenStreetMap.
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=

# Keys TouristAsk sends to read the partner feed (openssl rand -hex 32), comma separated. Give one to TouristAsk as PARTNER_API_KEY.
PARTNER_API_KEYS=
# Who is asked to approve a business, and who makes and posts the free kits.
OPERATOR_EMAILS=
KIT_ORDER_EMAIL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_AUTOMATIC_TAX=false
# Free days before the first payment. 0 = none.
TRIAL_DAYS=0
