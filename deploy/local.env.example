# Settings for running the whole stack on your own computer. Copy to local.env (compose.sh does this for you).
# local.env is ignored by git. Only fill in what you want to try; empty means "switched off".

# --- addresses (same ports as development) ---
PUBLIC_API_URL=http://localhost:8090
APP_URL=http://localhost:5190
API_SITE=http://localhost:8090
APP_SITE=http://localhost:5190
COOKIE_SECURE=false

# --- secrets (change these) ---
POSTGRES_PASSWORD=local-only-change-me
# openssl rand -base64 48
JWT_SECRET=local-only-change-me-local-only-change-me-12345

# --- captcha: Cloudflare's always-pass test keys, so the join form works locally in production mode ---
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- optional services (leave empty to switch off) ---
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@businessask.eu
GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=
# Keys TouristAsk sends to read the partner feed (openssl rand -hex 32), comma separated.
PARTNER_API_KEYS=
# Who is asked to approve a business, and who makes and posts the free kits.
OPERATOR_EMAILS=
KIT_ORDER_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_AUTOMATIC_TAX=false
TRIAL_DAYS=0
