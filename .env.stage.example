# .env.stage: copy to .env.stage and run "npm run stage". Everything on your computer's network address (phone testing). Replace 192.168.1.100 with your computer's address.
NODE_ENV=development
PORT=8090
PUBLIC_API_URL=http://192.168.1.100:8090
APP_URL=http://192.168.1.100:5190

DATABASE_URL=postgresql://brev:brev@localhost:5432/brev

# openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
COOKIE_SECURE=false

# Comma separated emails of the people who approve a business before TouristAsk shows it. They get a mail with approve and reject buttons.
OPERATOR_EMAILS=

# Keys the TouristAsk backend sends as x-api-key to read GET /partners. Comma separated. Generate: openssl rand -hex 32
PARTNER_API_KEYS=

# Places API (New), server key (look a business up from its Google Maps link).
GOOGLE_PLACES_API_KEY=

# Cloudflare Turnstile. For local testing use the always-pass secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=

# Brevo transactional email. Empty key = emails are logged instead of sent.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@businessask.eu
MAIL_FROM_NAME=BusinessAsk
