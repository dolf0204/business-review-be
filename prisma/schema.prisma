generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// A business owner (restaurant, cafe, bar, barber ...). Signs in to the business admin.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?
  name            String?
  uiLang          String     @default("en")
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  businesses      Business[]
  tokens          AuthToken[]
  uploads         Upload[]
  // The Stripe customer of this owner, created at the first checkout.
  stripeCustomerId String? @unique
}

// One-time links sent by email (confirm the address, reset the password). Only a hash is stored.
model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  kind      TokenKind
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

// One venue. This table is the source of truth for sponsors: TouristAsk reads it through GET /partners.
model Business {
  id            String    @id @default(uuid()) @db.Uuid
  ownerId       String    @db.Uuid
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Stable short code printed in the QR code and written on the NFC tag. Never changes.
  code          String    @unique
  name          String
  // The business kind, same values as TouristAsk sponsors: restaurant, cafe, bar, beauty, shop, sport, sight, beach, other.
  kind          String    @default("restaurant")
  subtitle      String?
  // The headline offer shown to TouristAsk guests, for example "10% off for our guests".
  offerText     String?
  address       String?
  lat           Float?
  lng           Float?
  googlePlaceId String?
  googleMapsUrl String?
  // Where guests are sent to review. Clicking counts as a review left.
  googleReviewUrl      String?
  tripadvisorReviewUrl String?
  websiteUrl    String?
  instagramUrl  String?
  facebookUrl   String?
  phone         String?
  contactEmail  String?
  // The logo (small, shown at the top of the page and in TouristAsk) and the picture behind the page header. Stored as /media/<id>.webp.
  logoUrl       String?
  backgroundUrl String?
  // Latest Google rating copied when the business is connected, shown on its card.
  rating        Float?
  ratingCount   Int?
  theme         Json      @default("{}")
  // Only published businesses are visible to guests and to TouristAsk.
  publishedAt   DateTime?
  // The operator has checked the page. Only approved businesses are given to TouristAsk as sponsors. Changing the name, offer or
  // Google place of an approved business clears this until it is checked again.
  approvedAt    DateTime?
  // The subscription is paid up to this moment. Null or past: the page is not shown to guests. Copied from Stripe whenever it changes.
  paidUntil     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         Post[]
  loyaltyProgram LoyaltyProgram?
  campaigns     Campaign[]
  subscription  BusinessSubscription?
  kitRequests   KitRequest[]
  coupons       Coupon[]
  memberships   Membership[]
  guestTokens   GuestToken[]

  @@index([ownerId])
  @@index([lat, lng])
}

// A visitor who joined a business by email. One account for all businesses, so the same person is recognised everywhere.
model Guest {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  name            String?
  lang            String       @default("en")
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())

  tokens          GuestToken[]
  memberships     Membership[]
}

// The one-time sign-in link emailed to a guest. Only a hash is stored. It remembers which business the guest came from.
model GuestToken {
  id           String   @id @default(uuid()) @db.Uuid
  guestId      String   @db.Uuid
  businessId   String   @db.Uuid
  tokenHash    String   @unique
  // The consent the guest ticked on the form; it is recorded only once the link is opened (the address is then proven).
  marketingOptIn Boolean @default(false)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  guest        Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([guestId, createdAt])
}

// A guest's relationship with one business. The loyalty card and the visit count will hang on this.
model Membership {
  id               String    @id @default(uuid()) @db.Uuid
  guestId          String    @db.Uuid
  businessId       String    @db.Uuid
  joinedAt         DateTime  @default(now())
  // Consent to receive this business's offers by email. Null means no consent (or withdrawn).
  marketingOptInAt DateTime?

  guest            Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Days on which the guest opened the page (one count per day). Review prompts and the loyalty card build on this.
  visits           Int       @default(0)
  lastVisitAt      DateTime?

  reviewPrompts    ReviewPrompt[]
  loyaltyCards     LoyaltyCard[]
  loyaltyPunches   LoyaltyPunch[]
  couponUses       CouponUse[]

  @@unique([guestId, businessId])
  @@index([businessId])
}

enum ReviewPlatform {
  GOOGLE
  TRIPADVISOR
}

enum ReviewPromptStatus {
  DONE     // the guest followed the review link
  DECLINED // the guest said no thanks; we ask again after a few more visits
}

// What happened when a guest was asked for a review on one platform.
model ReviewPrompt {
  id              String             @id @default(uuid()) @db.Uuid
  membershipId    String             @db.Uuid
  platform        ReviewPlatform
  status          ReviewPromptStatus
  // The guest's visit count when they said no thanks.
  declinedAtVisit Int                @default(0)
  updatedAt       DateTime           @updatedAt

  membership      Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, platform])
}

// News shown on the business page: a special offer or an announcement.
model Post {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  title      String
  body       String?
  // After this moment the post is no longer shown. Null means until the business removes it.
  endsAt     DateTime?
  createdAt  DateTime  @default(now())

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

enum LoyaltyMethod {
  LOCATION   // the guest's phone was near the business
  STAFF_CODE // the guest typed the code staff showed them
}

// The business's loyalty offer: collect `goal` visits, get the reward. One program per business.
model LoyaltyProgram {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @unique @db.Uuid
  enabled      Boolean   @default(false)
  goal         Int       @default(10)
  rewardText   String
  // Punches only count inside this window. Null means no limit on that side.
  startsAt     DateTime?
  endsAt       DateTime?
  // How close the guest's phone must be to the business.
  radiusMeters Int       @default(150)
  updatedAt    DateTime  @updatedAt

  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// One card of one guest. Goal and reward are copied when the card starts, so changing the program never changes a card in progress.
model LoyaltyCard {
  id           String    @id @default(uuid()) @db.Uuid
  membershipId String    @db.Uuid
  goal         Int
  rewardText   String
  completedAt  DateTime?
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())

  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  punches      LoyaltyPunch[]

  @@index([membershipId, createdAt])
}

// One stamp. The unique (membership, day) is what makes "one per day" true even if the button is tapped twice at once.
model LoyaltyPunch {
  id             String        @id @default(uuid()) @db.Uuid
  cardId         String        @db.Uuid
  membershipId   String        @db.Uuid
  day            String
  method         LoyaltyMethod
  distanceMeters Int?
  createdAt      DateTime      @default(now())

  card           LoyaltyCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  membership     Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, day])
  @@index([cardId])
}

enum CampaignStatus {
  SENDING
  SENT
}

// A special offer the business emailed to the guests who agreed to receive offers.
model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  businessId  String         @db.Uuid
  subject     String
  body        String
  status      CampaignStatus @default(SENDING)
  recipients  Int
  sentCount   Int            @default(0)
  failedCount Int            @default(0)
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

// An image an owner uploaded (logo, background). The file lives in UPLOAD_DIR; this row counts it against the owner's storage.
model Upload {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  filename  String   @unique
  bytes     Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

enum SubscriptionStatus {
  ACTIVE   // paid, or in the free trial
  PAST_DUE // the last payment failed; Stripe is still trying
  CANCELED
}

enum BillingInterval {
  MONTH
  YEAR
}

// One subscription per business. Stripe is the source of truth; this is what we last read from it.
model BusinessSubscription {
  id                   String             @id @default(uuid()) @db.Uuid
  businessId           String             @unique @db.Uuid
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(ACTIVE)
  interval             BillingInterval    @default(MONTH)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

enum KitStatus {
  REQUESTED
  SHIPPED
  CANCELED
}

// The free kit that comes with a paid page: a plastic sign with the QR code and an NFC tag, made and posted by the operator.
model KitRequest {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  status      KitStatus @default(REQUESTED)
  // Shipping address.
  name        String
  line1       String
  line2       String?
  postalCode  String
  city        String
  country     String
  phone       String?
  // The line printed on the sign, for example the business name.
  printText   String
  trackingUrl String?
  createdAt   DateTime  @default(now())
  shippedAt   DateTime?

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

// A discount a business offers its guests, for example "10% off lunch". A guest uses it once; staff confirm with the code of the day.
model Coupon {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  title       String
  description String?
  // Outside this window the coupon is not shown and cannot be used. Null means no limit on that side.
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  uses        CouponUse[]

  @@index([businessId, createdAt])
}

// A guest has used a coupon. The unique pair is what makes it once per guest, even if the button is tapped twice at once.
model CouponUse {
  id           String     @id @default(uuid()) @db.Uuid
  couponId     String     @db.Uuid
  membershipId String     @db.Uuid
  createdAt    DateTime   @default(now())

  coupon       Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([couponId, membershipId])
}
